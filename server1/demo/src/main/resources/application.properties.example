spring.application.name=demo
spring.datasource.url=jdbc:postgresql://localhost:5432/upi_demo
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

resilience4j.circuitbreaker.instances.bankService.registerHealthIndicator=true
resilience4j.circuitbreaker.instances.bankService.slidingWindowType=COUNT_BASED
resilience4j.circuitbreaker.instances.bankService.slidingWindowSize=5
resilience4j.circuitbreaker.instances.bankService.failureRateThreshold=50
resilience4j.circuitbreaker.instances.bankService.waitDurationInOpenState=10s
resilience4j.circuitbreaker.instances.bankService.permittedNumberOfCallsInHalfOpenState=2
